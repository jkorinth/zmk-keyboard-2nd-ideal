#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,physical-layout = &physical_layout0;
		zmk,kscan = &kscan0;
	};

	physical_layout0: physicial_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Default Layout";
		kscan = <&kscan0>;
		transform = <&default_transform>;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		rows = <4>;
		columns = <10>;
		map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(3,0)RC(3,5) RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
                        RC(3,3) RC(3,4)                RC(3,9) RC(3,8)
	RC(4,1)                                                                RC(4,6)
RC(4,0) RC(4,4) RC(4,2)                                                RC(4,7) RC(4,9) RC(4,5)
        RC(4,3)                                                                RC(4,8)
		>;
	};

	kscan0: kscan_composite {
		compatible = "zmk,kscan-composite";
		rows = <5>;
		columns = <10>;

		matrix {
			kscan = <&kscan1>;
		};

		direct {
			kscan = <&kscan2>;
			row-offset = <4>;
		};
	};

	kscan1: kscan_matrix {
		compatible = "zmk,kscan-gpio-matrix";
		wakeup-source;

		diode-direction = "row2col";
		poll-period-ms = <10>;
		row-gpios = <&pca9555 8 GPIO_ACTIVE_LOW>
		          , <&pca9555 9 GPIO_ACTIVE_LOW>
		          , <&pca9555 10 GPIO_ACTIVE_LOW>
		          , <&pca9555 11 GPIO_ACTIVE_LOW>
			  ;
		col-gpios = <&pca9555 0 GPIO_ACTIVE_LOW>
		          , <&pca9555 1 GPIO_ACTIVE_LOW>
		          , <&pca9555 2 GPIO_ACTIVE_LOW>
		          , <&pca9555 3 GPIO_ACTIVE_LOW>
		          , <&pca9555 4 GPIO_ACTIVE_LOW>
			  ;
	};

	kscan2: kscan_direct {
		compatible = "zmk,kscan-gpio-direct";
		wakeup-source;

		input-gpios = <&pca9555 12 GPIO_ACTIVE_LOW>
		            , <&pca9555 13 GPIO_ACTIVE_LOW>
		            , <&pca9555 14 GPIO_ACTIVE_LOW>
		            , <&pca9555 15 GPIO_ACTIVE_LOW>
		            , <&pca9555  6 GPIO_ACTIVE_LOW>
	            ;
	};

	encoder: encoder {
		compatible = "alps,ec11";
		a-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		b-gpios = <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		steps = <80>;
		status = "okay";
	};

	sensors: sensors {
		compatible = "zmk,keymap-sensors";
		sensors = <&encoder>;
		triggers-per-rotation = <20>;
	};

	aliases {
		led-strip = &led_strip;
	};
};
