#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,physical-layout = &physical_layout0;
	};

	physical_layout0: physicial_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Default Layout";
		kscan = <&kscan0>;
		transform = <&default_transform>;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <9>;
		map = <
RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4)                     RC(0, 5) RC(0, 6) RC(0, 7) RC(0, 8) RC(0, 9)
RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(0, 4)                     RC(1, 5) RC(1, 6) RC(1, 7) RC(1, 8) RC(1, 9)
RC(2, 0) RC(1, 1) RC(1, 2) RC(2, 3) RC(0, 4) RC(0, 0)   RC(0, 0) RC(2, 5) RC(2, 6) RC(2, 7) RC(2, 8) RC(2, 9)
                           RC(3, 3) RC(3, 4)                     RC(3, 5) RC(3, 6)
                  RC(4, 0)                                                         RC(4, 1)
         RC(4, 2) RC(4, 3) RC(4, 4)                                       RC(4, 5) RC(4, 6) RC(4, 7)
                  RC(4, 8)                                                         RC(4, 9)   
		>;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		wakeup-source;

		diode-direction = "row2col";
		row-gpios
			= <&pca9555 0 GPIO_ACTIVE_LOW>
			, <&pca9555 1 GPIO_ACTIVE_LOW>
			, <&pca9555 2 GPIO_ACTIVE_LOW>
			, <&pca9555 3 GPIO_ACTIVE_LOW>
			, <&pca9555 4 GPIO_ACTIVE_LOW>
			;
	};

	enc_a: enc_a {
		gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
	};

	enc_b: enc_b {
		gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		led-strip = &led_strip;
		enca = &enc_a;
		encb = &enc_b;
	};
};

